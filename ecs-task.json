{
  "family": "node-app-tasks",
  "networkMode": "awsvpc",
  "executionRoleArn": "arn:aws:iam::559050236729:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "nodeapp",
      "image": "826496717824.dkr.ecr.ap-south-1.amazonaws.com/nodeapp:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8080,
          "hostPort": 8080,
          "protocol": "tcp"
        }
      ]
    }
  ],
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024"
}
