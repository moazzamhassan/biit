{
  "family": "new1-taskdefinition",
  "networkMode": "awsvpc",
  "executionRoleArn": "arn:aws:iam::826496717824:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "new1-container",
      "image": "826496717824.dkr.ecr.ap-south-1.amazonaws.com/nodeapp:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 80,
          "hostPort": 80,
          "protocol": "tcp"
        }
      ]
    }
  ],
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024"
}
